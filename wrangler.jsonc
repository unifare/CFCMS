{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfpress",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfpress",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "content/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cfpress-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {"crons": ["*/5 * * * *"]},
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "services": [
    {
      "binding": "THEME_HOST",
      "service": "cfpress"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/media/*", "/admin/*", "/__cfpress/*"]
  }
}