{
  "name": "aurora",
  "title": "Aurora",
  "version": "1.0.0",
  "author": "CFPress",
  "description": "A long-form editorial theme. Warm paper palette, dark-mode-first tokens, drop caps, reading-time estimates and a sticky table of contents.",
  "supports": ["blocks", "menus", "widgets", "custom-logo"],
  "templates": [
    "index",
    "home",
    "single",
    "page",
    "archive",
    "category",
    "tag",
    "search",
    "404"
  ],
  "parts": ["header", "footer"],
  "routes": [
    {
      "path": "/writing",
      "template": "archive",
      "title": "Writing",
      "query": { "type": "post", "limit": 50, "order": "created_at desc" }
    }
  ],
  "settings": [
    {
      "key": "tagline",
      "label": "Tagline",
      "type": "text",
      "default": "Notes on building calm software."
    },
    {
      "key": "showReadingTime",
      "label": "Show reading time",
      "type": "boolean",
      "default": "true"
    },
    {
      "key": "accent",
      "label": "Accent colour",
      "type": "text",
      "default": "aurora"
    }
  ]
}
